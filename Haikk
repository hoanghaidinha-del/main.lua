-- Farm Loop
task.spawn(function()
	while task.wait(0.2) do
		if AutoFarm and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			
			local mob = getNearestMob()
			
			if mob then
				moveTo(mob.HumanoidRootPart.Position + Vector3.new(0,10,0))
				
